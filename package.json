{
  "name": "lan-chat",
  "version": "1.0.0",
  "description": "Chat LAN avec partage vidéo WebRTC et signalisation WebSocket",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:wayland": "electron . --disable-features=WaylandWpColorManagerV1",
    "install:desktop": "install-electron",
    "test": "npm run test:server && npm run test:media",
    "test:server": "node scripts/venv-python.cjs -m unittest discover -s tests -v",
    "test:media": "node tests/media.e2e.cjs",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint .",
    "lint:py": "node scripts/venv-python.cjs -m ruff check ."
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
